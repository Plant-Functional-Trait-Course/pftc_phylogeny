.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# target
*_targets/

# renv
# renv/activate.R and renv/settings.json are tracked on purpose: .Rprofile
# sources activate.R, so a clone without it errors on R startup.
renv/library/
renv/staging/
renv/local/
renv/cellar/
renv/sandbox/

# quarto

# data files
*.csv
*.xlsx
*.bib
*.pdf
*.rds
data/*
# keep small shared inputs in git (exceptions must come after data/*)
!data/metaCH.csv
!data/downscaled_climate.csv
# TNRS name resolutions, committed so the phylogeny builds without network
# access and the taxonomy stays pinned to what the analysis actually used
!data/taxonomy_tnrs.csv
WorldClimData/*
trackdown/*
Manuscript/google.R

